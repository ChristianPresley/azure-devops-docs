# Local docs-ui preview pipeline configuration.
# Sourced by .vscode/scripts/preview-*.sh tasks.
# Edit values here (or via the "preview: configure" task) instead of hard-coding in scripts.

# Path to the docs-ui repo root that contains the dcp-local + render + browser-sync packages.
DOCS_UI_ROOT="/git/external/docs-ui"

# Path to this azure-devops-docs repo (mirrors ${workspaceFolder}; kept explicit for shell use).
DOCS_REPO="/git/external/azure-devops-docs"

# Wireit cache hash to seed wwwroot from. Set by "preview: configure" task; falls back to newest cache if empty.
WIREIT_CACHE_HASH=""

# Where the chained-service logs land. Tasks read these.
DCP_LOG="/tmp/preview-dcp.log"
RENDER_LOG="/tmp/preview-render.log"
BS_LOG="/tmp/preview-bs.log"
